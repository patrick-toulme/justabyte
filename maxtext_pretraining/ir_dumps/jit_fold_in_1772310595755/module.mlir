module @jit_fold_in attributes {mhlo.num_partitions = 1 : i32, mhlo.num_replicas = 1 : i32} {
  func.func public @main(%arg0: tensor<4xui32> loc("key"), %arg1: tensor<i32> loc("data")) -> (tensor<4xui32> {jax.result_info = "result"}) {
    %c = stablehlo.constant dense<10> : tensor<i32> loc(#loc26)
    %c_0 = stablehlo.constant dense<0> : tensor<i32> loc(#loc)
    %c_1 = stablehlo.constant dense<-1> : tensor<i32> loc(#loc)
    %c_2 = stablehlo.constant dense<4294967295> : tensor<ui32> loc(#loc26)
    %c_3 = stablehlo.constant dense<32> : tensor<ui32> loc(#loc26)
    %0 = stablehlo.convert %arg1 : (tensor<i32>) -> tensor<ui32> loc(#loc27)
    %1 = stablehlo.shift_right_logical %0, %c_3 : tensor<ui32> loc(#loc28)
    %2 = stablehlo.broadcast_in_dim %1, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc29)
    %3 = stablehlo.and %0, %c_2 : tensor<ui32> loc(#loc30)
    %4 = stablehlo.broadcast_in_dim %3, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc29)
    %5 = stablehlo.concatenate %2, %4, dim = 0 : (tensor<1xui32>, tensor<1xui32>) -> tensor<2xui32> loc(#loc31)
    %6 = stablehlo.concatenate %5, %5, dim = 0 : (tensor<2xui32>, tensor<2xui32>) -> tensor<4xui32> loc(#loc31)
    %7 = stablehlo.reshape %6 : (tensor<4xui32>) -> tensor<2x2xui32> loc(#loc32)
    %8 = stablehlo.bitcast_convert %7 : (tensor<2x2xui32>) -> tensor<2xui64> loc(#loc32)
    %output_state, %output = stablehlo.rng_bit_generator %8, algorithm =  DEFAULT : (tensor<2xui64>) -> (tensor<2xui64>, tensor<10x4xui32>) loc(#loc32)
    %9 = stablehlo.compare  LT, %c_1, %c_0,  SIGNED : (tensor<i32>, tensor<i32>) -> tensor<i1> loc(#loc33)
    %10 = stablehlo.add %c_1, %c : tensor<i32> loc(#loc34)
    %11 = stablehlo.select %9, %10, %c_1 : tensor<i1>, tensor<i32> loc(#loc35)
    %12 = stablehlo.dynamic_slice %output, %11, %c_0, sizes = [1, 4] : (tensor<10x4xui32>, tensor<i32>, tensor<i32>) -> tensor<1x4xui32> loc(#loc36)
    %13 = stablehlo.reshape %12 : (tensor<1x4xui32>) -> tensor<4xui32> loc(#loc37)
    %14 = stablehlo.xor %arg0, %13 : tensor<4xui32> loc(#loc38)
    return %14 : tensor<4xui32> loc(#loc)
  } loc(#loc)
} loc(#loc)
