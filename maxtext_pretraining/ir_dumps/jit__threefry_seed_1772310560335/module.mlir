module @jit__threefry_seed attributes {mhlo.num_partitions = 1 : i32, mhlo.num_replicas = 1 : i32} {
  func.func public @main(%arg0: tensor<i32> loc("seed")) -> (tensor<2xui32> {jax.result_info = "result"}) {
    %c = stablehlo.constant dense<-1> : tensor<i32> loc(#loc)
    %c_0 = stablehlo.constant dense<32> : tensor<i32> loc(#loc)
    %0 = stablehlo.shift_right_logical %arg0, %c_0 : tensor<i32> loc(#loc31)
    %1 = stablehlo.convert %0 : (tensor<i32>) -> tensor<ui32> loc(#loc32)
    %2 = stablehlo.broadcast_in_dim %1, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc33)
    %3 = stablehlo.and %arg0, %c : tensor<i32> loc(#loc34)
    %4 = stablehlo.convert %3 : (tensor<i32>) -> tensor<ui32> loc(#loc32)
    %5 = stablehlo.broadcast_in_dim %4, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc33)
    %6 = stablehlo.concatenate %2, %5, dim = 0 : (tensor<1xui32>, tensor<1xui32>) -> tensor<2xui32> loc(#loc35)
    return %6 : tensor<2xui32> loc(#loc)
  } loc(#loc)
} loc(#loc)
