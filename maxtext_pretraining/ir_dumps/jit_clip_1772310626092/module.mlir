module @jit_clip attributes {mhlo.num_partitions = 1 : i32, mhlo.num_replicas = 1 : i32} {
  func.func public @main(%arg0: tensor<i32> loc("arr"), %arg1: tensor<i32> loc("min"), %arg2: tensor<i32> loc("max")) -> (tensor<i32> {jax.result_info = "result"}) {
    %0 = stablehlo.convert %arg1 : tensor<i32> loc(#loc33)
    %1 = stablehlo.maximum %0, %arg0 : tensor<i32> loc(#loc34)
    %2 = stablehlo.convert %arg2 : tensor<i32> loc(#loc33)
    %3 = stablehlo.minimum %2, %1 : tensor<i32> loc(#loc35)
    return %3 : tensor<i32> loc(#loc)
  } loc(#loc)
} loc(#loc)
