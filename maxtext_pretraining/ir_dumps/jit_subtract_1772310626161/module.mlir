module @jit_subtract attributes {mhlo.num_partitions = 1 : i32, mhlo.num_replicas = 1 : i32} {
  func.func public @main(%arg0: tensor<i32> loc("x"), %arg1: tensor<f32> loc("y")) -> (tensor<f32> {jax.result_info = "result"}) {
    %0 = stablehlo.convert %arg0 : (tensor<i32>) -> tensor<f32> loc(#loc32)
    %1 = stablehlo.subtract %0, %arg1 : tensor<f32> loc(#loc33)
    return %1 : tensor<f32> loc(#loc)
  } loc(#loc)
} loc(#loc)
